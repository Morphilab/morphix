# =====================================================
# Morphix — Environment Variables
# Copy this file to .env and configure the values
# =====================================================

# --- API Keys (at least one required: DEEPINFRA_API_KEY for the product
#     default provider, or one of the alternatives below) ---
# All model roles default to the same DeepInfra model (see MODEL_ROLES
# in core/config.py); get your key at deepinfra.com/dash/api_keys.
# Without this key the app falls back to Ollama (offline).
#DEEPINFRA_API_KEY=
#DEEPINFRA_API_BASE=https://api.deepinfra.com/v1/openai
DEEPSEEK_API_KEY=sk-xxxxxxxxxxx
OPENAI_API_KEY=sk-... (optional)
GROK_API_KEY= (optional)

# --- HuggingFace (optional, speeds up model download) ---
# Without HF_TOKEN, anonymous rate limits apply (slower).
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:xxx@localhost:5432/morphix
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# --- Ollama (optional, for offline / local mode) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Security ---
# Generate ENCRYPTION_KEY: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Generate PASSWORD_HASH: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
PASSWORD_HASH=

# --- Workspace ---
ACTIVE_WORKSPACE=main

# --- General ---
DARK_MODE=true       # true = oscuro (papel); false = claro (papel claro) — se aplica al reiniciar
OFFLINE_MODE=false
LLM_TIMEOUT=60
LLM_READ_TIMEOUT=300  # read-timeout del cliente LLM (una conexión muerta no cuelga el paso >5m)
# Máximo de sesiones Maestro simultáneas (se crean a demanda).
#   MAESTRO_MAX_SESSIONS=4
# MCP server tuning (línea máx. por request, timeout de request y de handshake)
# MCP_MAX_LINE_BYTES=4194304
# MCP_REQUEST_TIMEOUT=120
# MCP_INIT_TIMEOUT=15

# Embeddings (e5). En entornos air-gapped, pre-descarga el modelo
# intfloat/multilingual-e5-large y apunta HF_HOME a la caché local:
#   HF_HOME=/ruta/a/hf_cache
# EMBED_NORMALIZE=true
# Backend de embeddings seleccionable.
# EMBED_BACKEND=local            # local | ollama | openai | auto
# EMBED_MODEL=intfloat/multilingual-e5-large
# EMBED_DEVICE=auto              # auto | cpu | cuda | mps
# EMBED_BATCH_SIZE=32
# EMBED_PRELOAD=false            # precalienta en arranque
# EMBED_INDEX_POLICY=auto_rebuild  # ante mismatch de stamp: auto_rebuild | strict
# EMBED_INDEX_TIMEBOX_S=30       # espera máx de la vía automática antes de seguir sin contexto (0 = esperar siempre)

# Embeddings ONLINE vía endpoint OpenAI-compatible (p. ej. NVIDIA integrate
# con nvidia/nemotron-3-embed-1b, dim 2048 — el índice deriva la dimensión
# del backend solo). Clave DEDICADA de embeddings:
# EMBED_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBED_OPENAI_MODEL=nvidia/nemotron-3-embed-1b
# EMBED_OPENAI_API_KEY=nvapi-...
# EMBED_OPENAI_INPUT_TYPE=true   # passage/query para modelos instruidos (nemotron); OpenAI real lo rechaza
#
# ...o DeepInfra con Qwen/Qwen3-Embedding-8B (dim 4096 nativa). SOLO las
# queries llevan el prefijo de instrucción de Qwen3 — lo aplica el perfil
# qwen3-embedding de MODEL_PROFILES; input_type NO se envía (solo aplica a
# modelos VL). MISMA clave que DEEPINFRA_API_KEY:
# EMBED_OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBED_OPENAI_MODEL=Qwen/Qwen3-Embedding-8B
# EMBED_OPENAI_API_KEY=<la misma DEEPINFRA_API_KEY>
# Modelo de embeddings cuando EMBED_BACKEND=ollama:
# EMBED_OLLAMA_MODEL=nomic-embed-text

# Provisioning de workspaces desde templates/ (ver templates/workspaces.yaml).
# OFF por defecto: los workspaces de un clon no se imponen a otros clones.
#   AUTO_PROVISION_WORKSPACES=true
DEEPSEEK_API_BASE=https://api.deepseek.com  # Override for proxies or self-hosted
GROK_API_BASE=https://api.x.ai/v1            # Override for proxies or self-hosted
DEEPSEEK_STRICT_MODE=false
MAX_CONTEXT_TOKENS=128000
DEFAULT_AGENT=developer
FALLBACK_AGENT=conversacional
DEFAULT_WORKFLOW=development

# No hay caché Redis en el proyecto: REDIS_URL no existe como setting.
# Si algún día se cablea una caché real, su variable volverá aquí.

# --- Feature Flags ---
UNDERCOVER_MODE=true
DAEMON_MODE=true
SELF_HEAL_INTERVAL=120
VERBOSE_LOGGING=false
AUTO_FIX_LEVEL=2
CONTEXT_COMPRESSION=true
MAX_SUBTASKS=8
MAX_AGENT_ITERATIONS=8
TOOLS_ENABLED=true
ALLOW_CODE_EXECUTION=true
HOOKS_ENABLED=true
# Límite RLIMIT_AS (MB) del sandbox de code_exec (0 = sin límite; no recomendado).
# Se omite automáticamente si la memoria virtual del proceso ya excede el valor.
#   SANDBOX_MEMORY_MB=512
# Confinamiento OPT-IN del subprocess de bash_manager con bubblewrap
# (SANDBOX_BWRAP=true, leído directamente del entorno por bash_manager).
# Si el binario bwrap no está instalado, degrada con warning al modo normal.
#   SANDBOX_BWRAP=false

# --- Tool Settings ---
TOOL_MAX_TOKENS_PER_WORKFLOW=80000
TOOL_ENABLE_TOKEN_BUDGET=true
TOOL_MAX_RETRIES=3
TOOL_BACKOFF_BASE=1.5
# Vigencia (segundos) del "Always Allow" de aprobaciones de tools.
#   APPROVAL_ALWAYS_ALLOW_TTL=1800

# --- LLM Settings ---
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=1.5
LLM_RATE_PER_MINUTE=40
LLM_RATE_PER_HOUR=600
# Contador de reintentos LLM persistido en disco (sobrevive crashes y
# evita crash-loops con fallos deterministas).
#   LLM_RETRY_DURABLE=true
# Compresión cache-first: preserva el prefijo cacheable del transcript
# (system + primeras vueltas) para maximizar el prompt-cache del proveedor.
#   PROMPT_CACHE_PRESERVE_PREFIX=true
# Kill-switch global del function calling (false desactiva las tools
# para TODOS los roles).
#   TOOL_CALLING=true

# MORPHIX_ENV=production  # Uncomment to enforce production safety net (ENCRYPTION_KEY required)

# PATH para procesos hijos (bash/MCP/git) — default conservador:
# /usr/local/bin:/usr/bin:/bin. Si tus agentes trabajan en proyectos Python,
# define aquí el bin del venv donde viven pytest/ruff/black: sin él los agentes
# no pueden verificar por shell y queman iteraciones intentándolo.
# Localízalo con: uv run python -c "import sys,os;print(os.path.dirname(sys.executable))"
#MORPHIX_CHILD_ENV_PATH=/ruta/al/venv/bin:/usr/local/bin:/usr/bin:/bin

# ── NVIDIA integrate (OpenAI-compatible) ────────────────────────────────
# Pool de claves por modelo: NVIDIA_API_KEY_<n> emparejada con NVIDIA_MODEL_<n>
# (mismo índice). Con UN solo modelo basta una clave; sin emparejar y con
# varias, se usa la primera con warning. Sin ninguna clave NVIDIA, la
# selección de proveedor cae a Ollama como cualquier proveedor sin clave.
# La clave base NVIDIA_API_KEY también funciona (conveniencia mono-modelo).
#NVIDIA_API_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
#NVIDIA_MODEL_1=z-ai/glm-5.3-flash
#NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# ── DeepInfra (OpenAI-compatible) ───────────────────────────────────────
# Una sola clave (deepinfra.com/dash/api_keys) sirve chat y embeddings.
# Chat: TODOS los roles de model_roles corren aquí (DeepSeek V4.1 Flash,
# thinking model); los templates de agentes declaran model_role: deepinfra.
# Los demas proveedores (NVIDIA pool, DeepSeek, Grok, OpenAI) siguen
# soportados en la fabrica LLMProvider, sin roles de producto apuntandoles.
# Embeddings: Qwen/Qwen3-Embedding-8B vía EMBED_OPENAI_* (ver bloque de
# embeddings arriba). El reranker Qwen/Qwen3-Reranker-8B está documentado
# pero NO implementado (diseño aplazado).
# (Slots DEEPINFRA_API_KEY / DEEPINFRA_API_BASE promovidos al bloque de
#  claves principales, arriba.)

# ── Skills curator (opt-in) ─────────────────────────────────────────────
# Bucle de aprendizaje: telemetría de uso por workspace + walk determinista
# SOLO sobre skills con created_by: agent + archive restaurable. Sin flag no
# hay pase automático; el bucle manual corre con:
#   uv run python -m core.skills_curator_cli
#SKILLS_CURATOR_ENABLED=false
#SKILLS_CURATOR_STALE_AFTER_DAYS=30
#SKILLS_CURATOR_ARCHIVE_AFTER_DAYS=60
#SKILLS_CURATOR_INTERVAL_HOURS=24
#SKILLS_CURATOR_MIN_IDLE_HOURS=6

# ── Delegación ad-hoc (delegate_task) ───────────────────────────────────
# Subagentes con contexto aislado que reutilizan el loop de agente en
# proceso. La tool se expone vía MCP; los allowlists internos deben
# declararla explícitamente.
#DELEGATION_MAX_CONCURRENT_CHILDREN=3
#DELEGATION_CHILD_TIMEOUT_SECONDS=600
#DELEGATION_ORCHESTRATOR_ENABLED=true
#DELEGATION_MAX_SPAWN_DEPTH=2

# ── Backends de ejecución ────────────────────────────────────────────────
# Matriz pluggable local/docker (teardown TERM → grace → KILL). Docker
# requiere binario: sin él, el backend falla con error claro.
#EXECUTION_DEFAULT_BACKEND=local
#EXECUTION_DOCKER_IMAGE=python:3.12-slim
#EXECUTION_DOCKER_NETWORK=false
#EXECUTION_TERM_GRACE_SECONDS=5

# ── Logs estructurados ───────────────────────────────────────────────────
# Una línea JSON por evento (misma redacción de credenciales que el texto).
#LOG_JSON=false

# Cap de prompt por llamada en los runs DSL (0 = legado). Mantiene el coste
# por iteracion acotado: con 128k de contexto la compresion disparaba a ~90k
# y un run de presupuesto corto moria antes.
DSL_PROMPT_CAP_TOKENS=16000

# Streaming de agentes en runs DSL (default 0). El usage del streaming de
# DeepInfra no incluye el cache de prompt y el budget sobrecuenta ~3x; el
# progreso de la GUI sigue por status/mensajes. 1 = streaming opt-in.
DSL_STREAM_AGENTS=0
